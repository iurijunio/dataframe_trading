{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|exec_command|shell_command|apply_patch|mcp__.*preview_start",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -Command \"& (Join-Path (git rev-parse --show-toplevel) '.venv/Scripts/python.exe') (Join-Path (git rev-parse --show-toplevel) '.codex/hooks/guard.py')\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
